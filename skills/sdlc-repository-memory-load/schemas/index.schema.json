{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository-memory.dev/schemas/index.schema.json",
  "title": "Index",
  "description": "Repository memory index listing all tracked memory entries.",
  "type": "object",
  "required": ["schema_version", "generated_at", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version of the index format."
    },
    "generated_at": {
      "type": ["string", "null"],
      "description": "ISO 8601 timestamp of when the index was last generated, or null."
    },
    "entries": {
      "type": "array",
      "description": "List of memory entry references.",
      "items": {
        "type": "object",
        "required": ["id", "type", "path", "title", "summary", "tags", "updated_at", "confidence", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the memory entry."
          },
          "type": {
            "type": "string",
            "description": "Memory entry type category."
          },
          "path": {
            "type": "string",
            "description": "Relative file path within .ai-memory/."
          },
          "title": {
            "type": "string",
            "description": "Human-readable title of the memory entry."
          },
          "summary": {
            "type": "string",
            "description": "Brief summary of the memory content."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Tags for categorization and search."
          },
          "updated_at": {
            "type": "string",
            "description": "ISO 8601 timestamp of last update."
          },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
            "description": "Confidence level of the memory content."
          },
          "status": {
            "type": "string",
            "enum": ["synced", "pending_commit"],
            "description": "Sync status of the entry. 'needs_user_review' is NOT a valid index status."
          }
        }
      }
    },
    "excluded_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Paths excluded from indexing."
    }
  }
}