#!/bin/sh
# Pre-commit hook: enforces consistency rules with phase-aware policy.
#
# Rule 0: phase-aware policy (derived_sync_hook_policy.py)
#   - exit 0: apply_change with attributable stale drift -> ALLOW (skip
#     distribution-drift checks for the affected domains)
#   - exit 1: policy blocks (manual/mixed/unrelated/unattributed generated
#     changes) -> REJECT immediately with stable reason
#   - exit 2: no active workflow phase -> DEFER to existing checks below
#
# Rule 1: live .ai/workflows/ files must match canonical skill templates.
# Rule 2: canonical skill templates must match project-level distributed copies.
# Rule 3: canonical skills/ must match project-level distributed skill copies.
# Rule 4: canonical agents/ must match project-level distributed agent copies.
#
# Install: git config core.hooksPath .githooks
#
# Rule 0: phase-aware policy (derived_sync_hook_policy.py)
#   - exit 0: apply_change with attributable stale derived drift -> ALLOW.
#     Bypass ONLY generated-distribution drift checks (Rules 2-4).  Rule 1
#     (live .ai/workflows/ <-> canonical template) and unrelated checks MUST
#     still run; the policy only surfaces generated (.opencode/.claude/.cursor)
#     stale paths, not live template drift.
#   - exit 1: policy blocks (manual/mixed/unrelated/unattributed generated
#     changes) -> REJECT immediately with stable reason
#   - exit 2: no active workflow phase -> DEFER to all existing checks below
#
# Rule 1: live .ai/workflows/ files must match canonical skill templates.
# Rule 2: canonical skill templates must match project-level distributed copies.
# Rule 3: canonical skills/ must match project-level distributed skill copies.
# Rule 4: canonical agents/ must match project-level distributed agent copies.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SYNC_TOOL="$REPO_ROOT/skills/sdlc-project-bootstrap/scripts/sync_templates.py"
POLICY_TOOL="$REPO_ROOT/scripts/derived_sync_hook_policy.py"

if [ ! -f "$SYNC_TOOL" ]; then
    echo "ERROR: sync_templates.py not found at $SYNC_TOOL" >&2
    exit 1
fi

BLOCKED=0
# When the phase-aware policy allows attributable apply-phase drift, bypass
# ONLY the generated-distribution checks (Rules 2-4).  Rule 1 (live <->
# canonical template) is unrelated to generated distribution and MUST still
# run regardless of the policy allowance.
SKIP_DISTRIBUTION=0

# ---------------------------------------------------------------------------
# Rule 0: Phase-aware derived-sync policy
# ---------------------------------------------------------------------------
# Invoke the Python policy before existing checks.  The policy result
# decides whether expected apply-phase drift may bypass only the
# generated-distribution-drift checks (Rules 2-4); it must not
# short-circuit Rule 1 (live <-> canonical template) or unrelated hook rules.
POLICY_RC=2
if [ -f "$POLICY_TOOL" ]; then
    python3 "$POLICY_TOOL" --root "$REPO_ROOT" --json > /tmp/.precommit_policy_$$ 2>/tmp/.precommit_policy_err_$$
    POLICY_RC=$?
    POLICY_OUT="$(cat /tmp/.precommit_policy_$$ 2>/dev/null)"
    POLICY_ERR="$(cat /tmp/.precommit_policy_err_$$ 2>/dev/null)"
    rm -f /tmp/.precommit_policy_$$ /tmp/.precommit_policy_err_$$

    if [ $POLICY_RC -eq 1 ]; then
        # Policy blocks the commit (manual/mixed/unrelated/unattributed)
        echo ""
        echo "============================================"
        echo "  COMMIT BLOCKED: Phase-aware policy rejection"
        echo "============================================"
        echo ""
        # Extract stable reason and offending paths from JSON output
        REASON=$(echo "$POLICY_OUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('reason','unknown'))" 2>/dev/null)
        if [ -n "$REASON" ]; then
            echo "  Reason: $REASON"
        fi
        UNATTRIBUTED=$(echo "$POLICY_OUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(', '.join(d.get('unattributed_generated_paths',[])))" 2>/dev/null)
        if [ -n "$UNATTRIBUTED" ]; then
            echo "  Unattributed generated paths: $UNATTRIBUTED"
        fi
        DIRTY_GEN=$(echo "$POLICY_OUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(', '.join(d.get('actual_dirty_generated_paths',[])))" 2>/dev/null)
        if [ -n "$DIRTY_GEN" ]; then
            echo "  Dirty generated paths: $DIRTY_GEN"
        fi
        STAGED_GEN=$(echo "$POLICY_OUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(', '.join(d.get('actual_staged_generated_paths',[])))" 2>/dev/null)
        if [ -n "$STAGED_GEN" ]; then
            echo "  Staged generated paths: $STAGED_GEN"
        fi
        echo ""
        echo "Remove generated changes from the commit, restore unrelated drift,"
        echo "or repair workflow context as appropriate."
        echo ""
        if [ -n "$POLICY_ERR" ]; then
            echo "$POLICY_ERR" >&2
        fi
        exit 1
    fi
    # POLICY_RC=0: policy allows (apply_change with attributable drift).
    #   Bypass ONLY generated-distribution drift checks (Rules 2-4).  Rule 1
    #   (live <-> canonical template) must still run because the policy only
    #   surfaces generated (.opencode/.claude/.cursor) stale paths, not live
    #   template drift.
    # POLICY_RC=2: no active workflow -> defer to all checks below (no skip).
    if [ $POLICY_RC -eq 0 ]; then
        SKIP_DISTRIBUTION=1
    fi
    # POLICY_RC=2: fall through to all existing checks (SKIP_DISTRIBUTION=0)
fi

# ---------------------------------------------------------------------------
# Rule 1: live == canonical
#   When SKIP_DISTRIBUTION=0: ALWAYS runs (enforces live <-> canonical).
#   When SKIP_DISTRIBUTION=1 (apply_change policy allowed): runs with
#     phase-aware attribution.  Attributable drift (live governed workflow
#     source staged, template clean-but-stale) is allowed; unattributed or
#     manually-modified template drift is still blocked.
# ---------------------------------------------------------------------------
if [ $SKIP_DISTRIBUTION -eq 1 ]; then
    # Phase-aware Rule 1: allow attributable live-template drift.
    # The policy already confirmed we are in apply_change with attributable
    # generated drift.  Now check whether Rule 1 drift is also attributable
    # to staged live workflow source files.
    TEMPLATE_REPORT=$(python3 "$SYNC_TOOL" --root "$REPO_ROOT" --check --json 2>/dev/null)
    TEMPLATE_RC=$?
    if [ $TEMPLATE_RC -ne 0 ]; then
        # Drift exists — partition into attributable vs unattributed.
        # Attributable: the live path is staged (being authored) and the
        # template path is NOT manually modified (clean but stale).
        # Unattributed: the live path is not staged, or the template was
        # manually edited.
        UNATTRIBUTED_TEMPLATE=$(echo "$TEMPLATE_REPORT" | python3 -c "
import sys, json, subprocess
report = json.load(sys.stdin)
drifted = report.get('drifted', [])
staged = set(subprocess.run(['git', 'diff', '--cached', '--name-only', '-z'],
    capture_output=True, text=True).stdout.split('\\0'))
unattributed = []
for entry in drifted:
    # entry format: 'live_path -> template_path'
    parts = entry.split(' -> ', 1)
    live_path = parts[0].strip()
    template_path = parts[1].strip() if len(parts) > 1 else ''
    if live_path not in staged:
        unattributed.append(entry)
    elif template_path:
        # Check if template was manually modified (dirty in worktree)
        status = subprocess.run(['git', 'status', '--porcelain', '--', template_path],
            capture_output=True, text=True).stdout.strip()
        if status:
            unattributed.append(entry + ' (template manually modified)')
if unattributed:
    print('\\n'.join(unattributed))
" 2>/dev/null)
        if [ -n "$UNATTRIBUTED_TEMPLATE" ]; then
            echo ""
            echo "============================================"
            echo "  COMMIT BLOCKED: Unattributed template drift"
            echo "============================================"
            echo ""
            echo "Live .ai/workflows/ files differ from canonical templates in ways"
            echo "not attributable to staged apply-phase workflow source changes:"
            echo ""
            echo "$UNATTRIBUTED_TEMPLATE"
            echo ""
            echo "Run the following to sync live -> canonical, then re-commit:"
            echo ""
            echo "  python3 skills/sdlc-project-bootstrap/scripts/sync_templates.py --root ."
            echo ""
            BLOCKED=1
        fi
        # If all drift is attributable, allow (fall through without blocking).
    fi
else
    python3 "$SYNC_TOOL" --root "$REPO_ROOT" --check
    RET=$?
    if [ $RET -ne 0 ]; then
        echo ""
        echo "============================================"
        echo "  COMMIT BLOCKED: Template drift detected"
        echo "============================================"
        echo ""
        echo "Live .ai/workflows/ files differ from canonical skill templates."
        echo "Run the following to sync live -> canonical, then re-commit:"
        echo ""
        echo "  python3 skills/sdlc-project-bootstrap/scripts/sync_templates.py --root ."
        echo ""
        BLOCKED=1
    fi
fi

# ---------------------------------------------------------------------------
# Rules 2-4: generated-distribution drift checks.
# Skipped only when the phase-aware policy allows attributable apply-phase
# drift (SKIP_DISTRIBUTION=1).  These checks compare canonical templates /
# skills / agents against project-level distributed copies under .opencode/,
# .claude/, .cursor/ -- exactly the drift the policy is allowed to bypass.
# ---------------------------------------------------------------------------

# Rule 2: canonical == project-level distributed copies
if [ $SKIP_DISTRIBUTION -eq 0 ]; then
    python3 "$SYNC_TOOL" --root "$REPO_ROOT" --check-distributed
    RET=$?
    if [ $RET -ne 0 ]; then
        echo ""
        echo "============================================"
        echo "  COMMIT BLOCKED: Distributed drift detected"
        echo "============================================"
        echo ""
        echo "Canonical skill templates differ from one or more distributed copies"
        echo ".opencode/, .claude/, .cursor/. Run the following to re-distribute:"
        echo ""
        echo "  python3 skills/sdlc-project-bootstrap/scripts/sync_templates.py --root . --distribute"
        echo ""
        BLOCKED=1
    fi
fi

# Rule 3: canonical skills == project-level distributed copies (full directory tree)
# Only check skills that have staged canonical changes.
# Skipped when SKIP_DISTRIBUTION=1 (policy allowed attributable apply-phase drift).
if [ $SKIP_DISTRIBUTION -eq 0 ]; then
    STAGED_SKILLS=""
    STAGED_FILES=$(git diff --cached --name-only)
    for f in $STAGED_FILES; do
        case "$f" in
            skills/*)
                skill_name=$(echo "$f" | cut -d/ -f2)
                case " $STAGED_SKILLS " in
                    *" $skill_name "*) ;;
                    *) STAGED_SKILLS="$STAGED_SKILLS $skill_name" ;;
                esac
                ;;
        esac
    done
    STAGED_SKILLS=$(echo "$STAGED_SKILLS" | tr ' ' ',' | sed 's/^,//; s/,$//')

    if [ -n "$STAGED_SKILLS" ]; then
        python3 "$REPO_ROOT/skills/meta-skill-lifecycle-governance/scripts/check_skill_distribution.py" \
            --root "$REPO_ROOT" --skills "$STAGED_SKILLS"
        RET=$?
        if [ $RET -ne 0 ]; then
            echo ""
            echo "============================================"
            echo "  COMMIT BLOCKED: Skill distribution drift"
            echo "============================================"
            echo ""
            echo "Canonical skills/ differ from one or more distributed copies"
            echo ".opencode/, .claude/, .cursor/. Re-distribute the skill to fix:"
            echo ""
            echo "  python3 skills/meta-skill-lifecycle-governance/scripts/install_skill.py \\"
            echo "    --source-repo . --skill-name <skill> --source-ref HEAD \\"
            echo "    --target .opencode/skills/<skill> --status stable"
            echo "  repeat for .claude/skills/<skill> and .cursor/skills/<skill>"
            echo ""
            BLOCKED=1
        fi
    fi
fi

# Rule 4: canonical agents/ == project-level distributed copies
# Canonical edits require distributed copies to be refreshed and staged.
# Distributed-only changes are allowed when both install_agents.py --check
# and activate_agents_config.py --check pass on all three targets.
# Otherwise, distributed-only edits are blocked.
# Skipped when SKIP_DISTRIBUTION=1 (policy allowed attributable apply-phase drift).
if [ $SKIP_DISTRIBUTION -eq 0 ]; then
    STAGED_CANONICAL_AGENTS=""
    STAGED_DISTRIBUTED_AGENTS=""
    if [ -z "$STAGED_FILES" ]; then
        STAGED_FILES=$(git diff --cached --name-only)
    fi
    for f in $STAGED_FILES; do
        case "$f" in
            agents/*)
                STAGED_CANONICAL_AGENTS=1
                ;;
            .opencode/agents/*|.claude/agents/*|.cursor/agents/*)
                STAGED_DISTRIBUTED_AGENTS=1
                ;;
        esac
    done

    if [ -n "$STAGED_DISTRIBUTED_AGENTS" ] && [ -z "$STAGED_CANONICAL_AGENTS" ]; then
        # Distributed-only changes: require both install and activation
        # checks to pass on all three targets before allowing commit.
        AGENT_TOOL="$REPO_ROOT/scripts/install_agents.py"
        ACTIVATE_TOOL="$REPO_ROOT/scripts/activate_agents_config.py"
        DIST_BLOCKED=0
        for target in ".opencode/agents" ".claude/agents" ".cursor/agents"; do
            python3 "$AGENT_TOOL" --target "$REPO_ROOT/$target" --check
            if [ $? -ne 0 ]; then
                DIST_BLOCKED=1
            fi
            python3 "$ACTIVATE_TOOL" --target "$REPO_ROOT/$target" --check
            if [ $? -ne 0 ]; then
                DIST_BLOCKED=1
            fi
        done
        if [ $DIST_BLOCKED -ne 0 ]; then
            echo ""
            echo "============================================"
            echo "  COMMIT BLOCKED: Distributed agent drift"
            echo "============================================"
            echo ""
            echo "Distributed agent copies under .opencode/, .claude/, .cursor/"
            echo "have been modified but canonical agents/ were not staged."
            echo "If these are legitimate activation-managed changes, ensure both"
            echo "checks pass for all three targets:"
            echo ""
            echo "  python3 scripts/install_agents.py --target ./.opencode/agents --check"
            echo "  python3 scripts/activate_agents_config.py --target ./.opencode/agents --check"
            echo "  repeat for .claude/agents and .cursor/agents"
            echo ""
            echo "If the canonical agent prompt has changed, edit agents/ first,"
            echo "then re-distribute:"
            echo ""
            echo "  python3 scripts/install_agents.py --target ./.opencode/agents --force"
            echo "  python3 scripts/install_agents.py --target ./.claude/agents --force"
            echo "  python3 scripts/install_agents.py --target ./.cursor/agents --force"
            echo ""
            BLOCKED=1
        fi
    fi

    if [ -n "$STAGED_CANONICAL_AGENTS" ] && [ -z "$STAGED_DISTRIBUTED_AGENTS" ]; then
        echo ""
        echo "============================================"
        echo "  COMMIT BLOCKED: Distributed copies not staged"
        echo "============================================"
        echo ""
        echo "Canonical agents/ changed, but distributed copies were not staged."
        echo "Re-distribute and stage the generated copies before committing:"
        echo ""
        echo "  python3 scripts/install_agents.py --target ./.opencode/agents --force"
        echo "  python3 scripts/install_agents.py --target ./.claude/agents --force"
        echo "  python3 scripts/install_agents.py --target ./.cursor/agents --force"
        echo "  git add agents/ .opencode/agents/ .claude/agents/ .cursor/agents/"
        echo ""
        BLOCKED=1
    fi

    if [ -n "$STAGED_CANONICAL_AGENTS" ] || [ -n "$STAGED_DISTRIBUTED_AGENTS" ]; then
        AGENT_TOOL="$REPO_ROOT/scripts/install_agents.py"
        ACTIVATE_TOOL="$REPO_ROOT/scripts/activate_agents_config.py"
        AGENT_BLOCKED=0
        for target in ".opencode/agents" ".claude/agents" ".cursor/agents"; do
            python3 "$AGENT_TOOL" --target "$REPO_ROOT/$target" --check
            if [ $? -ne 0 ]; then
                AGENT_BLOCKED=1
            fi
            if [ -n "$STAGED_DISTRIBUTED_AGENTS" ]; then
                python3 "$ACTIVATE_TOOL" --target "$REPO_ROOT/$target" --check
                if [ $? -ne 0 ]; then
                    AGENT_BLOCKED=1
                fi
            fi
        done
        if [ $AGENT_BLOCKED -ne 0 ]; then
            echo ""
            echo "============================================"
            echo "  COMMIT BLOCKED: Agent distribution drift"
            echo "============================================"
            echo ""
            echo "Canonical agents/ differ from one or more distributed copies"
            echo ".opencode/, .claude/, .cursor/. Re-distribute to fix:"
            echo ""
            echo "  python3 scripts/install_agents.py --target ./.opencode/agents --force"
            echo "  python3 scripts/install_agents.py --target ./.claude/agents --force"
            echo "  python3 scripts/install_agents.py --target ./.cursor/agents --force"
            echo ""
            BLOCKED=1
        fi
    fi
fi

if [ $BLOCKED -ne 0 ]; then
    exit 1
fi

exit 0