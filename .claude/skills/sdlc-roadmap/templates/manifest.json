{
  "version": 1,
  "default_area": "<default-area-id>",
  "areas": [
    {
      "id": "<area-id>",
      "kind": "skill|workflow|agent|project|domain",
      "title": "<human-readable area name>",
      "path": "areas/<area-id>",
      "owner_path": "<source-path-for-kinded-entity>",
      "id_prefix": "<RM-PREFIX>"
    }
  ],
  "global_view": {
    "include_statuses": ["active", "ready", "planned"],
    "sort": ["priority", "order"]
  }
}
