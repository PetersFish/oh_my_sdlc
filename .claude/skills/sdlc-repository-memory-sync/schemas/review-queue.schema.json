{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repository-memory.dev/schemas/review-queue.schema.json",
  "title": "ReviewQueue",
  "description": "Queue of memory entries requiring user review before acceptance.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array",
      "description": "List of review items.",
      "items": {
        "type": "object",
        "required": ["id", "type", "source_sync_id", "reason", "title", "source_refs", "status", "created_at"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the review item."
          },
          "type": {
            "type": "string",
            "description": "Memory entry type."
          },
          "source_sync_id": {
            "type": "string",
            "description": "ID of the sync that produced this item."
          },
          "reason": {
            "type": "string",
            "description": "Reason the item requires review."
          },
          "title": {
            "type": "string",
            "description": "Title of the memory entry under review."
          },
          "source_refs": {
            "type": "object",
            "description": "References to source materials that produced this item.",
            "additionalProperties": false,
            "properties": {
              "commits": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Commit hashes referenced."
              },
              "specs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Spec identifiers referenced."
              },
              "snapshot_id": {
                "type": ["string", "null"],
                "description": "Snapshot ID referenced, or null."
              }
            }
          },
          "status": {
            "type": "string",
            "enum": ["open", "resolved", "dismissed"],
            "description": "Current status of the review item."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the review item was created."
          },
          "resolved_as": {
            "type": "string",
            "description": "How the item was resolved, if applicable."
          },
          "resolved_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 timestamp when the item was resolved."
          },
          "dismissed_reason": {
            "type": "string",
            "description": "Reason for dismissal, if applicable."
          }
        }
      }
    }
  }
}